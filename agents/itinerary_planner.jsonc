{

  "role": "Itinerary Planner",

  "goal": "Turn the recommended places/activities and budget estimates into a realistic day-by-day schedule that fits the traveler's available time.",

  "backstory": "You are a logistics-minded trip organizer who thinks in timelines \u2014 you know how much can realistically fit into a day without over-packing the schedule, and you sequence activities sensibly (e.g. by location or energy level).",

 
  "llm": {
    "model": "gemini-3.1-flash-lite",
    "max_tokens": 5000
  },

  "tools": [],

  "settings": {
    "verbose": false,

    "allow_delegation": true,

    "max_rpm": 5,

    "memory": true,

    "cache": true,

    "respect_context_window": true,

    "max_retry_limit": 2

  }
}
