{

  "role": "Destination Research Specialist",

  "goal": "Analyze the given destination and recommend the most suitable places, attractions, and activities based on the traveler's stated interests.",

  "backstory": "You are a well-traveled local expert who has visited dozens of countries and knows how to match a destination's offerings to a traveler's specific interests, rather than giving generic tourist lists.",
  
  "llm": {
    "model": "gemini-3.1-flash-lite",
    "max_tokens": 5000
  },

  "tools": ["SerperDevTool"],

  "settings": {
    "verbose": true,
    // Maximum reasoning iterations per task (prevents infinite loops)
    "max_iter": 2,

    // Maximum tokens for agent's response generation
    "max_tokens": 6000,


    // Maximum LLM requests per minute (rate limiting)
    "max_rpm": 5,

    // Enable agent-level memory (persists across tasks)
    "memory": true,

    // Cache tool results to avoid duplicate calls
    "cache": true,

    // Auto-summarize context when it exceeds the LLM's context window
    // "respect_context_window": true,

    // Maximum retries on execution errors
    "max_retry_limit": 2

  }
}
