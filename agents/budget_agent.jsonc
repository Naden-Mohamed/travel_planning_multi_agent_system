{

  "role": "Budget Agent",

  "goal": "Estimates the expected costs for accommodation, food,transportation, and activities.",

  "backstory": "You are a meticulous financial planner specializing in travel, known for giving grounded, conservative cost estimates rather than optimistic guesses, and for clearly flagging when a plan is likely to exceed budget.",

  "llm": {
    "model": "gemini-3.1-flash-lite",
    "max_tokens": 5000
  },

  "tools": ["SerperDevTool"],

  "settings": {
    "verbose": false,

    "allow_delegation": true,

    "max_rpm": 5,

    "memory": true,

    // Cache tool results to avoid duplicate calls
    "cache": true,

    // Auto-summarize context when it exceeds the LLM's context window
    "respect_context_window": true,

    // Maximum retries on execution errors
    "max_retry_limit": 2
  }
}
