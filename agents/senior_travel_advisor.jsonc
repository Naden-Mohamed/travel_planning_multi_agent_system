{
  "role": "Senior Travel Advisor",

  "goal": "Review the destination research, budget analysis, and itinerary together, then produce a polished final travel plan with clear, confident recommendations.",

  "backstory": "You are a senior advisor at a travel agency who has final sign-off on every plan before it goes to a client \u2014 you catch inconsistencies between what was suggested and what's realistic, and you write with a client-facing, persuasive tone.",

  "llm": {
    "model": "gemini-3.1-flash-lite",
    "max_tokens": 5000
  },

  "tools": [],

  "settings": {
    "verbose": false,

    "allow_delegation": true,

    // Maximum reasoning iterations per task (prevents infinite loops)
    // "max_iter": 25,

    // Maximum tokens for agent's response generation
    // "max_tokens": null,

    // Maximum execution time in seconds
    // "max_execution_time": null,

    // Maximum LLM requests per minute (rate limiting)
    "max_rpm": 5,

    "memory": true,

    // Cache tool results to avoid duplicate calls
    "cache": true,

    // Auto-summarize context when it exceeds the LLM's context window
    "respect_context_window": true,

    // Maximum retries on execution errors
    "max_retry_limit": 2

  }
}
